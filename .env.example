# ----------------------------------------------------------------------------
# BACKEND SECRETS — set with:  supabase secrets set --env-file supabase/.env
# Never commit the real file. Never put any of these in the Flutter app or admin config.
# ----------------------------------------------------------------------------

# Provided automatically inside Supabase Edge Functions (only needed for local `supabase functions serve`):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only!

# Shared secret for cron → Edge Function calls (generate: openssl rand -hex 32). Also store in Vault as 'cron_secret'.
CRON_SECRET=

# Identifies the website monitor to site owners (email or URL you control). Required before any web monitoring.
BOT_CONTACT=

# Push notifications (Firebase Cloud Messaging HTTP v1). Paste the service-account JSON on one line.
FCM_SERVICE_ACCOUNT_JSON=

# Email reminders (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Mauqa <reminders@your-domain.pk>"

# SMS (generic HTTPS gateway of your Pakistani SMS provider; adapt notify.ts if its API differs)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=Mauqa

# WhatsApp Business (Meta Cloud API) — requires an approved message template with 2 body variables
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Optional PDF/OCR worker (workers/ingest_worker.py)
PDF_EXTRACT_URL=
PDF_EXTRACT_TOKEN=

# Per-source connector credentials are referenced by NAME from data_sources.secret_ref, e.g.:
# NJP_API_TOKEN=          (only once NITB grants API access)
